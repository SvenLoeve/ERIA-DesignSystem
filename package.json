{
	"name": "eria-design-system",
	"version": "1.0.0",
	"description": "Design System for ERIA",
	"scripts": {
		"start": "run-p start:*",
		"start:eleventy": "eleventy --serve",
		"start:postcss": "postcss src/styles/*.css --dir public --watch",
		"build": "run-s clean build:eleventy build:postcss",
		"build:eleventy": "cross-env ELEVENTY_PRODUCTION=true eleventy",
		"build:postcss": "cross-env NODE_ENV=production postcss src/styles/*.css --dir public",
		"clean": "rimraf public"
	},
	"keywords": [
		"Design System",
		"ERIA"
	],
	"author": "ERIA",
	"license": "proprietary",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@tailwindcss/typography": "^0.5.20",
		"autoprefixer": "^10.5.4",
		"cross-env": "^10.1.0",
		"cssnano": "^8.0.2",
		"daisyui": "^5.7.28",
		"html-minifier-terser": "^7.2.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.28",
		"postcss-cli": "^12.0.0",
		"postcss-import": "^17.0.0",
		"rimraf": "^6.1.3",
		"tailwindcss": "^3.4.17"
	}
}
